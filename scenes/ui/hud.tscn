[node name="Instructions" type="Label" parent="ControlsPanel/MarginContainer/Controls"]
mouse_filter = 2
theme_override_font_sizes/font_size = 14
text = "Move with WASD or arrow keys.\nAim with the mouse. Green means in range.\nLeft click to cast. Left click again to reel in.\nFor fish, click or press Space in the green arc.\nRarer fish need two successful checks.\nPress E at the shack to trade.\nPress F on Sell to sell the entire Sack.\nPress Esc to go back or pause. Press H to hide Help."

